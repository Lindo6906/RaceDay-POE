@model List<RaceDay.Web.ViewModels.EnrolmentVm>
@{
    ViewData["Title"] = "All enrolments for my events";
}
<h1>All enrolments across my events</h1>
@if (Model.Count == 0)
{
    <p>No enrolments yet.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Event</th><th>Participant</th><th>Category</th><th>Status</th><th>Enrolled</th></tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.ParticipantName</td>
                    <td>@e.CategoryName</td>
                    <td>@e.Status</td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}